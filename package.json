{
  "name": "dualtran",
  "displayName": "DualTran \u2014 Translate in Place",
  "description": "Translate the selection and keep it next to the code: inline ghost line or side-by-side panel. Google or your own AI model (BYOK).",
  "version": "0.2.0",
  "publisher": "seigwenlee",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "translate",
    "translation",
    "i18n",
    "ai",
    "openai",
    "google"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seigwen/dualtran-vscode"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "dualtran.translateInline",
        "title": "%cmdTranslateInline%"
      },
      {
        "command": "dualtran.translatePanel",
        "title": "%cmdTranslatePanel%"
      },
      {
        "command": "dualtran.replaceSelection",
        "title": "%cmdReplaceSelection%"
      },
      {
        "command": "dualtran.clearInline",
        "title": "%cmdClearInline%"
      },
      {
        "command": "dualtran.pickTarget",
        "title": "%cmdPickTarget%"
      },
      {
        "command": "dualtran.setApiKey",
        "title": "%cmdSetApiKey%"
      },
      {
        "command": "dualtran.pickProvider",
        "title": "%cmdPickProvider%"
      },
      {
        "command": "dualtran.refreshProviders",
        "title": "%cmdRefreshProviders%"
      }
    ],
    "keybindings": [
      {
        "command": "dualtran.translateInline",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "dualtran.escape",
        "key": "escape",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%cfgSectionTitle%",
      "properties": {
        "dualtran.engine": {
          "type": "string",
          "enum": [
            "google",
            "ai"
          ],
          "enumDescriptions": [
            "%cfgEngineGoogle%",
            "%cfgEngineAi%"
          ],
          "default": "google",
          "description": "%cfgEngine%"
        },
        "dualtran.sourceLanguage": {
          "type": "string",
          "default": "auto",
          "description": "%cfgSource%"
        },
        "dualtran.targetLanguage": {
          "type": "string",
          "enum": [
            "af",
            "ar",
            "bg",
            "bn",
            "ca",
            "cs",
            "da",
            "de",
            "el",
            "en",
            "es",
            "et",
            "fa",
            "fi",
            "fr",
            "he",
            "hi",
            "hr",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "lt",
            "lv",
            "ms",
            "nl",
            "no",
            "pl",
            "pt",
            "pt-BR",
            "ro",
            "ru",
            "sk",
            "sl",
            "sr",
            "sv",
            "th",
            "tr",
            "uk",
            "ur",
            "vi",
            "zh-CN",
            "zh-TW"
          ],
          "enumDescriptions": [
            "Afrikaans",
            "Arabic",
            "Bulgarian",
            "Bengali",
            "Catalan",
            "Czech",
            "Danish",
            "German",
            "Greek",
            "English",
            "Spanish",
            "Estonian",
            "Persian",
            "Finnish",
            "French",
            "Hebrew",
            "Hindi",
            "Croatian",
            "Hungarian",
            "Indonesian",
            "Italian",
            "Japanese",
            "Korean",
            "Lithuanian",
            "Latvian",
            "Malay",
            "Dutch",
            "Norwegian",
            "Polish",
            "Portuguese",
            "Portuguese (Brazil)",
            "Romanian",
            "Russian",
            "Slovak",
            "Slovenian",
            "Serbian",
            "Swedish",
            "Thai",
            "Turkish",
            "Ukrainian",
            "Urdu",
            "Vietnamese",
            "Chinese (Simplified)",
            "Chinese (Traditional)"
          ],
          "default": "zh-CN",
          "description": "%cfgTarget%"
        },
        "dualtran.ai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%cfgEndpoint%"
        },
        "dualtran.ai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "%cfgModel%"
        },
        "dualtran.ai.provider": {
          "type": "string",
          "default": "openai",
          "markdownDescription": "%cfgProvider%"
        },
        "dualtran.ai.reasoning": {
          "type": "string",
          "enum": [
            "lowest",
            "default",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "%cfgReasoningLowest%",
            "%cfgReasoningDefault%",
            "%cfgReasoningNone%",
            "%cfgReasoningMinimal%",
            "%cfgReasoningLow%",
            "%cfgReasoningMedium%",
            "%cfgReasoningHigh%",
            "%cfgReasoningXhigh%",
            "%cfgReasoningMax%"
          ],
          "default": "lowest",
          "description": "%cfgReasoning%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "package": "vsce package",
    "e2e": "node e2e/run-tests.mjs",
    "verify": "npm test && npm run i18n:check && npm run e2e && npm run e2e:locale && npm run conformance",
    "i18n:build": "node scripts/build-nls.mjs",
    "i18n:sync": "node scripts/locale-kit.mjs",
    "i18n:check": "node scripts/locale-kit.mjs --check",
    "e2e:locale": "DT_LOCALE=de node e2e/run-tests.mjs",
    "conformance": "node scripts/conformance/run.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1"
  },
  "l10n": "./l10n"
}
